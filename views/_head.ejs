<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'JustInvoice' %></title>
  <meta name="description" content="JustInvoice — simple, flat-rate invoicing for freelancers. PDF invoices, Stripe payments, client tracking. No transaction fees.">
  <meta name="robots" content="noindex, follow">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://getjustinvoice.app/">
  <meta property="og:title" content="JustInvoice — Flat-rate invoicing for freelancers">
  <meta property="og:description" content="Free invoicing for freelancers. PDF invoices, Stripe payments, unlimited clients — no transaction fees.">
  <meta property="og:image" content="https://getjustinvoice.app/static/images/og-preview.png">

  <link rel="stylesheet" href="/static/app.css">
</head>
<body>
  <div class="container">
    <header class="nav">
      <h1><a href="/" style="text-decoration:none;">JustInvoice</a></h1>
      <nav>
        <% if (currentUser) { %>
          <a href="/">Dashboard</a>
          <a href="/invoices/new" class="primary">+ New invoice</a>
          <a href="/settings">Settings</a>
          <span class="muted" style="margin-left:1rem;"><%= currentUser.email %></span>
          <a href="/logout">Log out</a>
        <% } else { %>
          <a href="/login">Log in</a>
          <a href="/signup" class="primary">Sign up</a>
        <% } %>
      </nav>
    </header>

          <td><strong>JustInvoice</strong></td>
          <td>$9/mo (free now)</td>
          <td>$108/yr (free now)</td>
          <td>$0 fees</td>
        </tr>
        <tr>
          <td>Wave</td>
          <td>$0 + ~$86 in transaction fees</td>
          <td>$0 + ~$1,032 in fees</td>
          <td>~$14 per $500 invoice</td>
        </tr>
        <tr>
          <td>FreshBooks Lite</td>
          <td>$17/mo</td>

<script>
// Tax configuration for all 13 provinces/territories.
// Composition: { gst, pst, hst, qst, pst_label, hst_label, pst_compound_on_gst }
const TAX_CONFIG = {
  AB: { gst: 0.05, pst: 0,    hst: 0,      qst: 0,        hst_label: '',            pst_label: '',                compound: false },
  BC: { gst: 0.05, pst: 0.07, hst: 0,      qst: 0,        hst_label: '',            pst_label: 'PST (7%)',       compound: false },
  MB: { gst: 0.05, pst: 0.07, hst: 0,      qst: 0,        hst_label: '',            pst_label: 'RST (7%)',       compound: false },
  NB: { gst: 0,    pst: 0,    hst: 0.15,   qst: 0,        hst_label: 'HST (15%)',   pst_label: '',                compound: false },
  NL: { gst: 0,    pst: 0,    hst: 0.15,   qst: 0,        hst_label: 'HST (15%)',   pst_label: '',                compound: false },
  NS: { gst: 0,    pst: 0,    hst: 0.14,   qst: 0,        hst_label: 'HST (14%)',   pst_label: '',                compound: false },
  ON: { gst: 0,    pst: 0,    hst: 0.13,   qst: 0,        hst_label: 'HST (13%)',   pst_label: '',                compound: false },
  PE: { gst: 0,    pst: 0,    hst: 0.15,   qst: 0,        hst_label: 'HST (15%)',   pst_label: '',                compound: false },
  QC: { gst: 0.05, pst: 0,    hst: 0,      qst: 0.09975,  hst_label: '',            pst_label: 'QST (9.975%)',   compound: true  }, // QST calculated on subtotal+GST
  SK: { gst: 0.05, pst: 0.06, hst: 0,      qst: 0,        hst_label: '',            pst_label: 'PST (6%)',       compound: false },
  NT: { gst: 0.05, pst: 0,    hst: 0,      qst: 0,        hst_label: '',            pst_label: '',                compound: false },
  NU: { gst: 0.05, pst: 0,    hst: 0,      qst: 0,        hst_label: '',            pst_label: '',                compound: false },
  YT: { gst: 0.05, pst: 0,    hst: 0,      qst: 0,        hst_label: '',            pst_label: '',                compound: false },
};

const $ = (id) => document.getElementById(id);

function fmt(n) {
  return '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}

function parseAmount(v) {
  if (typeof v === 'number') return v;
  // Strip $, commas, spaces
  const cleaned = String(v).replace(/[$,\s]/g, '');
  const n = parseFloat(cleaned);
  return isNaN(n) ? 0 : n;
}

function calculate() {
  const province = $('province').value;
  const type = document.querySelector('input[name="calc-type"]:checked').value;
  const inputAmount = parseAmount($('amount').value);
  const cfg = TAX_CONFIG[province];

  if (inputAmount <= 0) {
    $('r-subtotal').textContent = '$0.00';
    $('r-gst').textContent = '$0.00';
    $('r-pst').textContent = '$0.00';
    $('r-hst').textContent = '$0.00';
    $('r-total').textContent = '$0.00';
    $('email-capture').style.display = 'none';
    return;
  }

  let subtotal, gst, pst, hst, total;

  if (type === 'forward') {
    // Price before tax → add tax
    subtotal = inputAmount;
    gst = subtotal * cfg.gst;
    if (cfg.hst > 0) {
      // HST province: single combined tax, no separate GST
      hst = subtotal * cfg.hst;
      pst = 0;
    } else {
      hst = 0;
      if (cfg.compound) {
        // QC: QST on subtotal + GST
        pst = (subtotal + gst) * cfg.qst;
      } else {
        pst = subtotal * cfg.pst;
      }
    }
    total = subtotal + gst + pst + hst;
  } else {
    // Reverse: price includes tax → extract subtotal
    // For HST provinces: subtotal = total / (1 + hst_rate)
    // For GST+PST provinces (non-compound): subtotal = total / (1 + gst + pst)
    // For QC (compound): subtotal = total / (1 + gst + qst * (1 + gst))
    if (cfg.hst > 0) {
      subtotal = inputAmount / (1 + cfg.hst);
      hst = inputAmount - subtotal;
      gst = 0;
      pst = 0;
    } else {
      if (cfg.compound) {
        // QC: total = subtotal * (1 + gst) * (1 + qst)
        // subtotal = total / ((1 + gst) * (1 + qst))
        subtotal = inputAmount / ((1 + cfg.gst) * (1 + cfg.qst));
        gst = subtotal * cfg.gst;
        pst = (subtotal + gst) * cfg.qst;
      } else {
        subtotal = inputAmount / (1 + cfg.gst + cfg.pst);
        gst = subtotal * cfg.gst;
        pst = subtotal * cfg.pst;
      }
      hst = 0;
    }
    total = inputAmount;
  }

  // Show/hide tax rows based on province config
  // GST row: only show for non-HST provinces that have a separate GST
  $('row-gst').style.display = (cfg.gst > 0 && cfg.hst === 0) ? 'flex' : 'none';
  $('row-hst').style.display = (cfg.hst > 0) ? 'flex' : 'none';
  $('row-pst').style.display = (cfg.pst > 0 || cfg.qst > 0) ? 'flex' : 'none';

  $('r-hst-label').textContent = cfg.hst_label;
  $('r-pst-label').textContent = cfg.pst_label;
  $('r-subtotal').textContent = fmt(subtotal);
  $('r-gst').textContent = fmt(gst);
  $('r-pst').textContent = fmt(pst);
  $('r-hst').textContent = fmt(hst);
  $('r-total').textContent = fmt(total);

  // Show email capture after first successful calculation
  $('email-capture').style.display = 'block';
}

function submitEmail(event) {
  event.preventDefault();
  const email = $('email').value;
  if (!email) return false;
  // For v1: just show confirmation. Real PDF generation can be added in v2.
  const btn = event.target.querySelector('button');
  btn.textContent = 'Thanks! PDF coming soon.';
  btn.disabled = true;
  $('email').disabled = true;
  // Optional: log to console for now, no backend call yet
  console.log('Email capture (TODO: wire to backend):', email);
  return false;
}

// Wire up inputs
['province', 'amount'].forEach(id => {
  $(id).addEventListener('input', calculate);
  $(id).addEventListener('change', calculate);
});
document.querySelectorAll('input[name="calc-type"]').forEach(r => {
  r.addEventListener('change', calculate);
});

// Initial calculation on page load (with default 100.00 in Ontario)
calculate();
</script>


<%- include('_head', { title: 'Dashboard — JustInvoice' }) %>

<h2>Invoices</h2>

<div class="stats">
  <div class="stat">
    <div class="label">Total invoices</div>
    <div class="value"><%= totals.count %></div>
  </div>
  <div class="stat">
    <div class="label">Outstanding</div>
    <div class="value"><%= formatMoney(totals.outstanding) %></div>
  </div>
  <div class="stat">
    <div class="label">Paid</div>
    <div class="value"><%= formatMoney(totals.paid) %></div>
  </div>
  <div class="stat">
    <div class="label">Lifetime total</div>
    <div class="value"><%= formatMoney(totals.total) %></div>
  </div>
</div>

<% if (invoices.length === 0) { %>
  <div class="card empty">
    <p>No invoices yet.</p>
    <a href="/invoices/new" class="btn">Create your first invoice</a>
  </div>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Number</th>
        <th>Client</th>
        <th>Due</th>
        <th>Status</th>
        <th class="num">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% invoices.forEach(inv => { %>
        <tr>
          <td><a href="/invoices/<%= inv.id %>"><%= inv.number %></a></td>
          <td><%= inv.client_name %></td>
          <td><%= inv.due_date %></td>
          <td>
            <span class="badge <%= inv.status %>"><%= inv.status %></span>
            <% if (inv.status === 'sent' && (userSettings.default_payment_mode === 'etransfer' || userSettings.default_payment_mode === 'both')) { %>
              <form method="post" action="/invoices/<%= inv.id %>/mark-paid" style="display:inline; margin-left:0.5rem;">
                <input type="hidden" name="payment_method" value="etransfer">
                <button type="submit" style="font-size:0.75rem; padding:0.2rem 0.6rem; background:#16a34a; color:#fff; border:none; border-radius:4px; cursor:pointer; white-space:nowrap;">Mark paid</button>
              </form>
            <% } %>
          </td>
          <td class="num"><%= formatMoney(inv.total_cents, inv.currency) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('_foot') %>

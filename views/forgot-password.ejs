<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/static/landing.css">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%232563eb'/><text x='16' y='23' font-size='20' text-anchor='middle' fill='white' font-family='system-ui' font-weight='bold'>J</text></svg>">
</head>
<body>

<nav class="landing-nav">
  <div class="landing-nav-inner">
    <a href="/" class="logo">Just<span>Invoice</span></a>
    <nav>
      <a href="/login">Log in</a>
      <a href="/signup" class="btn-primary">Get started free</a>
    </nav>
  </div>
</nav>

<div style="max-width: 420px; margin: 3rem auto; padding: 0 1.5rem;">
  <h2 style="font-size:1.5rem; font-weight:700; letter-spacing:-0.02em; margin-bottom:0.25rem;">Forgot your password?</h2>
  <p class="muted" style="margin-bottom:1.5rem;">Enter your email and we'll send you a reset link.</p>

  <% if (error) { %>
    <div style="background:#fbeaea; border:1px solid #9a1f1f; border-radius:8px; padding:0.75rem 1rem; margin-bottom:1rem; font-size:0.9rem; color:#9a1f1f;">
      ⚠ <%= error %>
    </div>
  <% } %>

  <% if (message) { %>
    <div style="background:#eaf4ea; border:1px solid #1f6b2b; border-radius:8px; padding:0.75rem 1rem; margin-bottom:1rem; font-size:0.9rem; color:#1f6b2b;">
      ✓ <%= message %>
    </div>
  <% } %>

  <% if (!message) { %>
  <form method="post" action="/forgot-password" style="background:var(--bg-alt); border:1px solid var(--border); border-radius:10px; padding:1.5rem;">
    <div style="margin-bottom:1.25rem;">
      <label for="email" style="display:block; font-size:0.85rem; color:var(--muted); margin-bottom:0.35rem;">Email address</label>
      <input type="email" id="email" name="email" autocomplete="email" required autofocus
        style="width:100%; padding:0.55rem 0.7rem; border:1px solid var(--border); border-radius:6px; font-size:0.95rem; font-family:inherit;">
    </div>
    <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
      <button type="submit" style="padding:0.55rem 1.25rem; font-size:0.9rem; border:1px solid var(--ink); background:var(--ink); color:#fff; border-radius:6px; cursor:pointer; font-family:inherit;">Send reset link</button>
      <a href="/login" style="padding:0.55rem 1rem; font-size:0.9rem; border:1px solid var(--border); background:#fff; color:var(--muted); border-radius:6px; text-decoration:none;">Back to login</a>
    </div>
  </form>
  <% } else { %>
    <p style="margin-top:1rem; font-size:0.9rem;"><a href="/login" style="color:var(--ink);">← Back to login</a></p>
  <% } %>
</div>

</body>
</html>

<!-- ── How it works ── -->
<section class="section section-alt">
  <p class="section-label">How it works</p>
  <h2 class="section-title">Create. Send. Get paid.</h2>
  <p class="section-sub">Three steps. No accounting degree required.</p>
  <div class="steps">
    <div class="step">
      <div class="step-num">1</div>
      <h3>Create your invoice</h3>
      <p>Pick a client, add line items, set a due date. That's it.</p>
    </div>
    <div class="step">
      <div class="step-num">2</div>
      <h3>Send it</h3>
      <p>One click to email a clean PDF — or copy a share link.</p>
    </div>
    <div class="step">
      <div class="step-num">3</div>
      <h3>Get paid</h3>
      <p>Your choice: client pays by card via Stripe (one click) or sends you an Interac e-Transfer. You mark it paid when it clears.</p>
    </div>
  </div>
</section>


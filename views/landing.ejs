<script>
  (function () {
    // (lightbox removed — See it in action section now uses an embedded YouTube video)
  })();

  // ── Live launch countdown + counters ──
  (function () {
    // Real launch date — adjust LAUNCH_DATE_STRING if you move the launch.
    // Format: ISO 8601 with timezone (e.g. "2026-08-15T00:00:00-04:00" for 12am ET).
    var LAUNCH_DATE_STRING = '2026-08-15T00:00:00-04:00';
    var launchDate = new Date(LAUNCH_DATE_STRING);

    function renderCountdown() {
      var el = document.getElementById('launch-countdown');
      if (!el) return;
      var diff = launchDate.getTime() - Date.now();
      if (diff <= 0) {
        el.textContent = 'Launch day — now $9/month';
        return;
      }
      var days = Math.floor(diff / 86400000);
      var hours = Math.floor((diff % 86400000) / 3600000);
      var mins = Math.floor((diff % 3600000) / 60000);
      el.textContent = 'Free for ' + days + ' day' + (days === 1 ? '' : 's') +
                       ', ' + hours + 'h ' + mins + 'm until $9/month launches';
    }
    renderCountdown();
    setInterval(renderCountdown, 60000); // refresh every minute

    // Fetch live user count + last invoice time from /api/stats
    fetch('/api/stats')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (stats) {
        if (!stats) return;
        var uc = document.getElementById('user-count');
        var li = document.getElementById('last-invoice-time');
        if (uc && typeof stats.user_count === 'number') {
          uc.textContent = stats.user_count + '+';
        }
        if (li && stats.last_invoice_at) {
          var mins = Math.floor((Date.now() - new Date(stats.last_invoice_at).getTime()) / 60000);
          if (mins < 1) li.textContent = 'just now';
          else if (mins < 60) li.textContent = mins + ' minute' + (mins === 1 ? '' : 's') + ' ago';
          else if (mins < 1440) li.textContent = Math.floor(mins / 60) + ' hour' + (Math.floor(mins / 60) === 1 ? '' : 's') + ' ago';
          else li.textContent = Math.floor(mins / 1440) + ' day' + (Math.floor(mins / 1440) === 1 ? '' : 's') + ' ago';
        }
      })
      .catch(function () { /* silently fall back to placeholders */ });
  })();
</script>


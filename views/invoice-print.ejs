<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Invoice <%= invoice.number %></title>
<style>
  * { box-sizing: border-box; }
  body { font-family: -apple-system, "Helvetica Neue", Arial, sans-serif; color: #1a1a1a; margin: 0; padding: 0; font-size: 11pt; line-height: 1.45; }
  .sheet { padding: 0; }
  .head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2.5rem; }
  .head h1 { font-size: 28pt; margin: 0 0 0.25rem; letter-spacing: -0.02em; }
  .head .num { color: #666; font-size: 10pt; }
  .business { text-align: right; }
  .business strong { font-size: 12pt; }
  .business .muted { color: #666; font-size: 10pt; white-space: pre-line; }
  .meta { display: flex; gap: 2rem; margin-bottom: 2rem; padding: 1rem 0; border-top: 1px solid #ddd; border-bottom: 1px solid #ddd; }
  .meta .block { flex: 1; }
  .meta .label { text-transform: uppercase; letter-spacing: 0.05em; font-size: 8.5pt; color: #888; margin-bottom: 0.25rem; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
  th, td { padding: 0.6rem 0.5rem; text-align: left; font-size: 10.5pt; }
  th { text-transform: uppercase; letter-spacing: 0.05em; font-size: 8.5pt; color: #666; border-bottom: 2px solid #1a1a1a; }
  td { border-bottom: 1px solid #eee; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .totals { margin-left: auto; width: 40%; }
  .totals tr td { border: none; padding: 0.3rem 0.5rem; }
  .totals .grand td { border-top: 2px solid #1a1a1a; font-size: 13pt; padding-top: 0.5rem; font-weight: 600; }
  .notes { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #ddd; font-size: 10.5pt; white-space: pre-wrap; color: #333; }
  .notes .label { text-transform: uppercase; letter-spacing: 0.05em; font-size: 8.5pt; color: #888; margin-bottom: 0.5rem; }
</style>
</head>
<body>
<div class="sheet">
  <div class="head">
    <div>
      <h1>Invoice</h1>
      <div class="num">#<%= invoice.number %></div>
    </div>
    <div class="business">
      <strong><%= settings.business_name %></strong><br>
      <span class="muted"><%= settings.business_email %></span>
      <% if (settings.business_address) { %>
        <br><span class="muted"><%= settings.business_address %></span>
      <% } %>
    </div>
  </div>

  <div class="meta">
    <div class="block">
      <div class="label">Billed to</div>
      <strong><%= invoice.client_name %></strong>
      <% if (invoice.client_email) { %><br><span style="color:#666;"><%= invoice.client_email %></span><% } %>
      <% if (invoice.client_address) { %><br><span style="color:#666; white-space:pre-wrap;"><%= invoice.client_address %></span><% } %>
    </div>
    <div class="block">
      <div class="label">Issue date</div>
      <%= invoice.issue_date %>
    </div>
    <div class="block">
      <div class="label">Due date</div>
      <%= invoice.due_date %>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Description</th>
        <th class="num" style="width:80px;">Qty</th>
        <th class="num" style="width:110px;">Unit</th>
        <th class="num" style="width:120px;">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% invoice.items.forEach(it => { %>
        <tr>
          <td><%= it.description %></td>
          <td class="num"><%= it.quantity %></td>
          <td class="num"><%= formatMoney(it.unit_price_cents, invoice.currency) %></td>
          <td class="num"><%= formatMoney(lineTotal(it), invoice.currency) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <table class="totals">
    <% if (invoice.tax_cents > 0) { %>
    <tr>
      <td>Subtotal</td>
      <td class="num"><%= formatMoney(invoice.subtotal_cents, invoice.currency) %></td>
    </tr>
    <tr>
      <td><%= invoice.tax_name %> (<%= invoice.tax_rate_pct %>%)</td>
      <td class="num"><%= formatMoney(invoice.tax_cents, invoice.currency) %></td>
    </tr>
    <% } %>
    <tr class="grand">
      <td>Total due</td>
      <td class="num"><%= formatMoney(invoice.total_cents, invoice.currency) %></td>
    </tr>
  </table>

  <% if (invoice.notes) { %>
    <div class="notes">
      <div class="label">Notes</div>
      <%= invoice.notes %>
    </div>
  <% } %>
</div>
</body>
</html>

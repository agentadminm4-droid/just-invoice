# JustInvoice environment config
# Copy to `.env` and fill in your values.

# Port to run the app on (default 3000)
PORT=3000

# Session signing secret. MUST be set. Use a long random string in production,
# e.g. `openssl rand -hex 32`. Without this the server will refuse to start.
SESSION_SECRET=

# Public base URL of the app. Used for Stripe Checkout success/cancel URLs.
# For local dev: http://localhost:3000
# For prod: https://invoices.yourdomain.com
BASE_URL=http://localhost:3000

# Stripe API keys. Get these from https://dashboard.stripe.com/apikeys
# Use sk_test_... keys until you're ready to take real money.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret. Get this from https://dashboard.stripe.com/webhooks
# For local dev with the Stripe CLI, it's printed when you run `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Resend API key for sending invoice emails. Get one at https://resend.com/api-keys
# Leave blank to disable email sending (the "Send to Client" button will hide).
RESEND_API_KEY=

# "From" address used when sending invoice emails. For testing, Resend's shared
# sender `onboarding@resend.dev` works without domain verification.
# For production, verify your domain in Resend and use something like
# invoices@yourdomain.com
EMAIL_FROM=onboarding@resend.dev
